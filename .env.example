# ============================================
# LiveKit (self-hosted / custom domain)
# ============================================
LIVEKIT_URL=wss://livekit.example.com
LIVEKIT_API_KEY=YOUR_LIVEKIT_API_KEY
LIVEKIT_API_SECRET=YOUR_LIVEKIT_API_SECRET
# HTTP API base for the server (used only by the explicit /api/livekit/dispatch endpoint)
LIVEKIT_API_URL=https://livekit.example.com

# ============================================
# Agent worker
# ============================================
LIVEKIT_AGENT_NAME=soul-library-voice-assistant
# Leave empty for self-hosted servers (dispatch matching). Only set for hosted deployments.
LIVEKIT_AGENT_DEPLOYMENT=
LIVEKIT_AGENT_DISPLAY_NAME=SOUL Library Assistant
# 1 = lifecycle INFO logs (default), 0 = silence them (errors still logged)
LIVEKIT_AGENT_LOGS=1

# ============================================
# Debug audio dumps (STT input)
# ============================================
# 1 = save every STT audio segment as WAV to voice-tmp/ for quality inspection
# 0 = off (default, safe for production)
DEBUG_DUMP_AUDIO=0

# ============================================
# LLM (Groq)
# ============================================
GROQ_API_KEY=gsk_your_groq_key
GROQ_MODEL=llama-3.3-70b-versatile

# ============================================
# STT - hosted faster-whisper server
# ============================================
STT_URL=https://stt-server.example.com

# ============================================
# TTS - hosted Kokoro server
# ============================================
TTS_URL=https://tts-server.example.com
TTS_LANGUAGE=hi
TTS_VOICE=hm_psi
TTS_SPEED=1.0
TTS_SAMPLE_RATE=44100

# ============================================
# Library text-to-SQL backend (voice agent tool)
# ============================================
LIBRARY_AGENT_URL=http://localhost:7698
LIBRARY_AGENT_TIMEOUT=60

# ============================================
# Access token TTL (seconds)
# ============================================
LIVEKIT_TOKEN_TTL=3600
